@model List<CourseWork.Models.CartItem>
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Кошик";
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal grandTotal = Model.Sum(x => x.TotalPrice);
}

<div class="container mt-4">
    <h2><i class="bi bi-cart3"></i> Ваш кошик</h2>
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (Model.Any())
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-0">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th>Товар</th>
                                    <th>Ціна</th>
                                    <th style="width: 140px;">Кількість</th>
                                    <th>Сума</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.png" : item.ImageUrl)"
                                                     class="rounded me-3" style="width: 60px; height: 60px; object-fit: cover;">
                                                <div>
                                                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId" class="text-decoration-none text-dark fw-bold">
                                                        @item.ProductName
                                                    </a>
                                                    <small class="text-muted d-block">@item.WeightInfo</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@item.Price.ToString("N0") ₴</td>

                                        <td>
                                            <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center">
                                                <input type="hidden" name="variantId" value="@item.VariantId" />

                                                <button type="submit" name="quantity" value="@(item.Quantity - 1)" class="btn btn-sm btn-outline-secondary px-2">
                                                    <i class="bi bi-dash"></i>
                                                </button>

                                                <input type="text" class="form-control form-control-sm text-center mx-1 border-0 bg-white"
                                                       value="@item.Quantity" readonly style="width: 40px; font-weight: bold;">

                                                <button type="submit" name="quantity" value="@(item.Quantity + 1)" class="btn btn-sm btn-outline-secondary px-2">
                                                    <i class="bi bi-plus"></i>
                                                </button>
                                            </form>
                                        </td>

                                        <td class="fw-bold">@item.TotalPrice.ToString("N0") ₴</td>
                                        <td>
                                            <a asp-action="Remove" asp-route-variantId="@item.VariantId" class="text-danger" title="Видалити">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mt-3 d-flex justify-content-between">
                    <a asp-action="Clear" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-trash"></i> Очистити кошик
                    </a>

                    <a asp-controller="Shop" asp-action="Index" class="btn btn-link text-decoration-none">
                        <i class="bi bi-arrow-left"></i> Продовжити покупки
                    </a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm border-0 bg-light">
                    <div class="card-body">
                        <h4 class="d-flex justify-content-between align-items-center mb-4">
                            <span>Разом:</span>
                            <span class="text-success fw-bold">@grandTotal.ToString("N0") ₴</span>
                        </h4>

                        <a asp-controller="Checkout" asp-action="Index" class="btn btn-success w-100 py-3 fs-5 shadow-sm">
                            Оформити замовлення <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="mb-3">
                <span class="bg-light rounded-circle p-4 d-inline-block">
                    <i class="bi bi-basket2 display-1 text-muted"></i>
                </span>
            </div>
            <h3>Ваш кошик порожній</h3>
            <p class="text-muted">Знайдіть щось смачненьке в каталозі!</p>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-primary mt-3 px-4 py-2">
                Перейти до каталогу
            </a>
        </div>
    }
</div>