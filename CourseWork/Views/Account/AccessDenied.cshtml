@{
    ViewData["Title"] = "Доступ заборонено";
}

<div class="container d-flex flex-column justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="text-center">
        <i class="bi bi-shield-lock-fill text-danger" style="font-size: 5rem;"></i>
        <h1 class="mt-3 text-danger fw-bold">Доступ заборонено</h1>

        <p class="lead text-muted">
            Вибачте, у вас недостатньо прав для перегляду цієї сторінки.<br />
            Зверніться до адміністратора або поверніться на головну.
        </p>

        <div class="mt-4">
            <a asp-controller="Shop" asp-action="Index" class="btn btn-primary px-4 py-2 shadow-sm">
                <i class="bi bi-house-door me-2"></i>Повернутися до магазину
            </a>
        </div>
    </div>
</div>