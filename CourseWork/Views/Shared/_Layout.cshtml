@using CourseWork.Extensions
@using CourseWork.Models
@inject IHttpContextAccessor HttpContextAccessor
@using CourseWork.Constants


@{
    var cart = HttpContextAccessor.HttpContext.Session.GetObject<List<CartItem>>("Cart");
    int cartCount = cart?.Sum(item => item.Quantity) ?? 0;

}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SweetShop</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />


    <style>
        .sidebar {
            min-height: 100vh;
            background-color: #221f1f;
            color: white;
            position: sticky;
            top: 0;
            height: 100vh;
            overflow-y: auto;
        }

            .sidebar .nav-link {
                color: #ccc;
                text-decoration: none;
                padding: 12px 20px;
                display: block;
                transition: 0.2s;
                border-left: 4px solid transparent;
            }

                .sidebar .nav-link:hover {
                    color: #fff;
                    background-color: #333;
                    border-left-color: #00a046;
                }

                .sidebar .nav-link.active-link {
                    background-color: #2c2c2c;
                    color: white;
                    border-left-color: #00a046;
                    font-weight: bold;
                }

        .content-area {
            background-color: #f5f5f5;
            min-height: 100vh;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-2 sidebar p-0 d-flex flex-column">

                <div class="p-3 text-center border-bottom border-secondary">
                    <h3 class="fw-bold text-white mb-0">
                        <i class="text-success"></i> SweetShop
                    </h3>
                </div>

                <div class="p-3 border-bottom border-secondary" style="background-color: #2c2c2c;">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-light w-100 mb-2 text-start border-0">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-success d-flex align-items-center justify-content-center text-white me-2" style="width: 35px; height: 35px;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <div class="text-truncate">
                                    <small class="d-block text-muted" style="font-size: 10px;">Мій кабінет</small>
                                    <span class="fw-bold">@User.Identity.Name</span>
                                </div>
                            </div>
                        </a>

                        <div class="d-grid gap-2">
                            @if (User.IsInRole(UserRoles.Admin) || User.IsInRole(UserRoles.Manager))
                            {
                                <a asp-controller="Home" asp-action="Index" class="btn btn-warning btn-sm">
                                    <i class="bi bi-speedometer2"></i> Адмін-панель
                                </a>
                            }

                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-outline-secondary btn-sm w-100">
                                    <i class="bi bi-box-arrow-right"></i> Вийти
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-success w-100">
                            <i class="bi bi-box-arrow-in-right"></i> Вхід
                        </a>
                    }
                </div>

                <nav class="mt-3 flex-grow-1">
                    <a asp-controller="Shop" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Shop" ? "active-link" : "")">
                        <i class="bi bi-grid-fill me-2"></i> Каталог товарів
                    </a>

                    <a asp-controller="Cart" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Cart" ? "active-link" : "")">
                        <div class="d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-cart me-2"></i> Кошик</span>
                            @if (cartCount > 0)
                            {
                                <span class="badge bg-danger rounded-pill">@cartCount</span>
                            }
                        </div>
                    </a>
                </nav>

                <footer class="p-3 text-center text-muted small mt-auto border-top border-secondary">
                    &copy; @DateTime.Now.Year SweetShop
                </footer>
            </div>

            <div class="col-md-10 content-area p-4">
                <main role="main">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function updateCardState(priceId, statusId, priceRaw, isAvailable, btn) {
            const price = parseFloat(priceRaw);
            const priceEl = document.getElementById(priceId);
            if (priceEl) priceEl.innerHTML = price.toLocaleString('uk-UA', { minimumFractionDigits: 0, maximumFractionDigits: 2 }) + ' <span class="price-currency">₴</span>';

            const statusEl = document.getElementById(statusId);
            if (statusEl) {
                if (isAvailable) {
                    statusEl.textContent = "В наявності";
                    statusEl.className = "fw-bold text-success";
                } else {
                    statusEl.textContent = "Закінчився";
                    statusEl.className = "fw-bold text-muted";
                }
            }

            const container = btn.closest('.variant-container');
            if (container) {
                const allButtons = container.querySelectorAll('button');
                allButtons.forEach(b => {
                    b.classList.remove('btn-success');
                    b.classList.add('btn-outline-secondary');
                });
                btn.classList.remove('btn-outline-secondary');
                btn.classList.add('btn-success');
            }
        }

        $(document).ready(function () {
            $('.select-search').select2({
                theme: 'bootstrap-5', 
                width: '100%',
                placeholder: $(this).data('placeholder'),
                language: {
                    noResults: function () {
                        return "Нічого не знайдено";
                    }
                }
            });
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
</body>
</html>