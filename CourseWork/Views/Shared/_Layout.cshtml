<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SweetShop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .sidebar { min-height: 100vh; background-color: #221f1f; color: white; }
        .sidebar a { color: #ccc; text-decoration: none; padding: 10px; display: block; }
        .sidebar a:hover { color: #fff; background-color: #333; }
        .sidebar .active { background-color: #00a046; color: white; }
        .content-area { background-color: #f5f5f5; min-height: 100vh; }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-2 sidebar p-0">
                <div class="p-3 text-center border-bottom border-secondary">
                    <h3>🍬 SweetShop</h3>
                </div>
                <nav class="mt-3">
                    <a asp-controller="Shop" asp-action="Index" class="active"><i class="bi bi-grid-fill me-2"></i> Каталог</a>
                    <a href="#"><i class="bi bi-percent me-2"></i> Акції</a>
                    <a href="#"><i class="bi bi-heart me-2"></i> Обране</a>
                    <a href="#"><i class="bi bi-cart me-2"></i> Кошик</a>
                    <hr class="border-secondary mx-3">
                    <a asp-controller="Home" asp-action="Index"><i class="bi bi-gear me-2"></i> Адмін-панель</a>
                </nav>
            </div>

            <div class="col-md-10 content-area p-4">
                <main role="main">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>