@model IEnumerable<CourseWork.Models.Product>
@{
    ViewData["Title"] = "Каталог товарів";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .product-card {
        transition: transform 0.2s;
        border: 1px solid #eee;
    }

        .product-card:hover {
            transform: translateY(-5px);
            border-color: #00a046;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

    .price-tag {
        font-size: 1.2rem;
        font-weight: bold;
        color: #f84147;
    }

    .old-price {
        text-decoration: line-through;
        color: #999;
        font-size: 0.9rem;
    }

    .stock-badge {
        font-size: 0.8rem;
    }
</style>

<div class="row mb-4 bg-light p-3 rounded border">
    <form method="get" id="filterForm" class="row g-3 align-items-center">

        <div class="col-md-3">
            <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="🔍 Пошук..." />
        </div>

        <div class="col-md-2">
            <select name="brandId" class="form-select" asp-items="@(new SelectList(ViewBag.Brands, "BrandId", "BrandName", ViewBag.CurrentBrand))">
                <option value="">Всі бренди</option>
            </select>
        </div>

        <div class="col-md-2">
            <select name="typeId" class="form-select" asp-items="@(new SelectList(ViewBag.Types, "TypeOfProductId", "TypeOfProductName", ViewBag.CurrentType))">
                <option value="">Всі типи</option>
            </select>
        </div>

        <div class="col-md-2">
            <select name="minRating" class="form-select text-warning fw-bold">
                <option value="" class="text-dark">Будь-який рейтинг</option>
                <option value="5" selected="@(ViewBag.CurrentRating == 5)">⭐⭐⭐⭐⭐ (5)</option>
                <option value="4" selected="@(ViewBag.CurrentRating == 4)">⭐⭐⭐⭐ (4+)</option>
                <option value="3" selected="@(ViewBag.CurrentRating == 3)">⭐⭐⭐ (3+)</option>
                <option value="1" selected="@(ViewBag.CurrentRating == 1)">⭐ (1+)</option>
            </select>
        </div>

        <div class="col-md-2">
            <select name="sortOrder" class="form-select">
                <option value="newest" selected="@(ViewBag.CurrentSort == "newest")">Новинки</option>
                <option value="price_asc" selected="@(ViewBag.CurrentSort == "price_asc")">Дешевші</option>
                <option value="price_desc" selected="@(ViewBag.CurrentSort == "price_desc")">Дорожчі</option>
            </select>
        </div>

        <div class="col-md-1">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter"></i></button>
        </div>
    </form>
</div>

@if (ViewBag.CurrentRating != null && ViewBag.CurrentBrand != null)
{
    <div class="alert alert-info py-2 small">
        <i class="bi bi-database-fill-gear"></i> Використано збережену процедуру <strong>sp_GetProductsByBrandAndRating</strong>
    </div>
}

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    @foreach (var p in Model)
    {
        decimal minPrice = 0;
        if (p.ProductVariants.Any())
        {
            minPrice = p.ProductVariants.Min(v => v.Price);
        }

        int totalStock = p.ProductVariants
        .SelectMany(v => v.ProductBatches)
        .Sum(b => b.Stock);

        bool isAvailable = totalStock > 0;

        <div class="col">
            <div class="card h-100 product-card p-2">
                <a asp-action="Details" asp-route-id="@p.ProductId">
                    <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/no-image.png" : p.ImageUrl)"
                         class="card-img-top" style="height: 180px; object-fit: contain;" alt="@p.Name">
                </a>

                <div class="card-body d-flex flex-column">
                    <div class="text-warning small mb-1">
                        @for (int i = 0; i < 5; i++)
                        {
                            <i class="bi @(i < p.AggregateRating ? "bi-star-fill" : "bi-star")"></i>
                        }
                        <span class="text-muted">(@p.AggregateRating)</span>
                    </div>

                    <a asp-action="Details" asp-route-id="@p.ProductId" class="text-dark text-decoration-none fw-bold mb-2">
                        @p.Name
                    </a>

                    <div class="mt-auto">
                        @if (isAvailable)
                        {
                            <div class="text-success stock-badge mb-2"><i class="bi bi-check-lg"></i> В наявності</div>
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="price-tag">@minPrice.ToString("N0") ₴</div>
                                <a asp-action="Details" asp-route-id="@p.ProductId" class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-cart"></i>
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted stock-badge mb-2"><i class="bi bi-dash-circle"></i> Закінчився</div>
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="text-muted">-----</div>
                                <button disabled class="btn btn-sm btn-light">Повідомити</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>