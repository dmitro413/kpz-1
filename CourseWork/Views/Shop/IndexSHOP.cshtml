@model IEnumerable<CourseWork.Core.Models.Product>
@{
    ViewData["Title"] = "Каталог товарів";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var minDate = DateOnly.FromDateTime(DateTime.Now.AddDays(7));

}

<style>
    .product-card {
        transition: transform 0.2s;
        border: 1px solid #eee;
    }

        .product-card:hover {
            transform: translateY(-5px);
            border-color: #00a046;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

    .price-tag {
        font-size: 1.2rem;
        font-weight: bold;
        color: #f84147;
    }

    .product-name {
        text-decoration: none;
        color: #333;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: auto; 
        min-height: 50px; 
        line-height: 1.3; 
        font-size: 0.95rem;
    }

        .product-name:hover {
            color: #00a046;
        }

    .stock-badge {
        font-size: 0.8rem;
    }

    .btn-cart:hover {
        background-color: #00a046;
        color: white;
    }
</style>

<div class="row mb-4 bg-light p-3 rounded border mx-0">
    <form method="get" id="filterForm" class="row g-3 align-items-center w-100 m-0">
        <div class="col-md-3">
            <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="🔍 Пошук..." />
        </div>
        <div class="col-md-2">
            <select name="brandId" class="form-select" asp-items="@(new SelectList(ViewBag.Brands, "BrandId", "BrandName", ViewBag.CurrentBrand))">
                <option value="">Всі бренди</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="typeId" class="form-select" asp-items="@(new SelectList(ViewBag.Types, "TypeOfProductId", "TypeOfProductName", ViewBag.CurrentType))">
                <option value="">Всі типи</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="minRating" class="form-select fw-bold text-success">
                <option value="" class="text-dark">Всі товари</option>
                <option value="1" selected="@(ViewBag.CurrentRating == 1)">Позитивні (>0)</option>
                <option value="5" selected="@(ViewBag.CurrentRating == 5)">Популярні (>5)</option>
                <option value="10" selected="@(ViewBag.CurrentRating == 10)">Топ (>10)</option>
                <option value="50" selected="@(ViewBag.CurrentRating == 50)">Хіти (>50)</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="sortOrder" class="form-select">
                <option value="newest" selected="@(ViewBag.CurrentSort == "newest")">Новинки</option>
                <option value="rating" selected="@(ViewBag.CurrentSort == "rating")">Популярні</option>
                <option value="price_asc" selected="@(ViewBag.CurrentSort == "price_asc")">Дешевші</option>
                <option value="price_desc" selected="@(ViewBag.CurrentSort == "price_desc")">Дорожчі</option>
            </select>
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter"></i></button>
        </div>
    </form>
    <div class="row">
        <div class="col-12 text-center">
            @await Component.InvokeAsync("NavigationMenu")
        </div>
    </div>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    @if (Model.Any())
    {
        @foreach (var p in Model)
        {
            <div class="col">
                <partial name="_ProductSummary" model="p" />
            </div>
        }
    }
</div>

@if (ViewBag.TotalPages > 1)
{
    <nav aria-label="Page navigation" class="mt-5">
        <ul class="pagination justify-content-center">

            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                   asp-route-searchString="@ViewBag.CurrentSearch"
                   asp-route-brandId="@ViewBag.CurrentBrand"
                   asp-route-typeId="@ViewBag.CurrentType"
                   asp-route-minRating="@ViewBag.CurrentRating"
                   asp-route-sortOrder="@ViewBag.CurrentSort">
                    &laquo; Назад
                </a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@i"
                       asp-route-searchString="@ViewBag.CurrentSearch"
                       asp-route-brandId="@ViewBag.CurrentBrand"
                       asp-route-typeId="@ViewBag.CurrentType"
                       asp-route-minRating="@ViewBag.CurrentRating"
                       asp-route-sortOrder="@ViewBag.CurrentSort">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                   asp-route-searchString="@ViewBag.CurrentSearch"
                   asp-route-brandId="@ViewBag.CurrentBrand"
                   asp-route-typeId="@ViewBag.CurrentType"
                   asp-route-minRating="@ViewBag.CurrentRating"
                   asp-route-sortOrder="@ViewBag.CurrentSort">
                    Вперед &raquo;
                </a>
            </li>
        </ul>
    </nav>
}
@section Scripts {
    <script>
        connection.on("ReceiveStockUpdate", function (productId, variantId, newStock) {

            const statusContainer = document.getElementById(`status-container-${productId}`);
            if (statusContainer) {
                let newHtml;
                if (newStock > 0) {
                    newHtml = `
                        <small class="fw-bold text-success">В наявності (${newStock} шт.)</small>
                        <a href="/Shop/Details/${productId}" class="btn btn-outline-success btn-cart rounded-circle p-2 border-0 bg-light">
                            <i class="bi bi-cart3 fs-5"></i>
                        </a>`;
                } else {
                    newHtml = `
                        <small class="fw-bold text-muted">Закінчився</small>
                        <a href="/Shop/Details/${productId}" class="btn btn-outline-secondary btn-cart rounded-circle p-2 border-0 bg-light">
                            <i class="bi bi-cart3 fs-5"></i>
                        </a>`;
                }
                statusContainer.innerHTML = newHtml;
            }
        });
    </script>
}


