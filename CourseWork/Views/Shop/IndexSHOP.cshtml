@model IEnumerable<CourseWork.Models.Product>
@{
    ViewData["Title"] = "Каталог товарів";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var minDate = DateOnly.FromDateTime(DateTime.Now.AddDays(7));

}

<style>
    .product-card {
        transition: transform 0.2s;
        border: 1px solid #eee;
    }

        .product-card:hover {
            transform: translateY(-5px);
            border-color: #00a046;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

    .price-tag {
        font-size: 1.2rem;
        font-weight: bold;
        color: #f84147;
    }

    .product-name {
        text-decoration: none;
        color: #333;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: auto; 
        min-height: 50px; 
        line-height: 1.3; 
        font-size: 0.95rem;
    }

        .product-name:hover {
            color: #00a046;
        }

    .stock-badge {
        font-size: 0.8rem;
    }

    .btn-cart:hover {
        background-color: #00a046;
        color: white;
    }
</style>

<div class="row mb-4 bg-light p-3 rounded border mx-0">
    <form method="get" id="filterForm" class="row g-3 align-items-center w-100 m-0">
        <div class="col-md-3">
            <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="🔍 Пошук..." />
        </div>
        <div class="col-md-2">
            <select name="brandId" class="form-select" asp-items="@(new SelectList(ViewBag.Brands, "BrandId", "BrandName", ViewBag.CurrentBrand))">
                <option value="">Всі бренди</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="typeId" class="form-select" asp-items="@(new SelectList(ViewBag.Types, "TypeOfProductId", "TypeOfProductName", ViewBag.CurrentType))">
                <option value="">Всі типи</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="minRating" class="form-select fw-bold text-success">
                <option value="" class="text-dark">Всі товари</option>
                <option value="1" selected="@(ViewBag.CurrentRating == 1)">Позитивні (>0)</option>
                <option value="5" selected="@(ViewBag.CurrentRating == 5)">Популярні (>5)</option>
                <option value="10" selected="@(ViewBag.CurrentRating == 10)">Топ (>10)</option>
                <option value="50" selected="@(ViewBag.CurrentRating == 50)">Хіти (>50)</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="sortOrder" class="form-select">
                <option value="newest" selected="@(ViewBag.CurrentSort == "newest")">Новинки</option>
                <option value="rating" selected="@(ViewBag.CurrentSort == "rating")">Популярні</option>
                <option value="price_asc" selected="@(ViewBag.CurrentSort == "price_asc")">Дешевші</option>
                <option value="price_desc" selected="@(ViewBag.CurrentSort == "price_desc")">Дорожчі</option>
            </select>
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter"></i></button>
        </div>
    </form>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    @if (Model.Any())
    {
        @foreach (var p in Model)
        {
            <div class="col">
                <div class="card h-100 product-card p-2 position-relative">
                    @if (p.AggregateRating != 0)
                    {
                        var badgeClass = p.AggregateRating > 0 ? "bg-success" : "bg-danger";
                        <div class="position-absolute top-0 end-0 m-2 px-2 py-1 @badgeClass text-white rounded small fw-bold shadow-sm" style="z-index: 10;">
                            <i class="bi @(p.AggregateRating > 0 ? "bi-hand-thumbs-up-fill" : "bi-hand-thumbs-down-fill")"></i> @p.AggregateRating
                        </div>
                    }

                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@p.ProductId" class="text-center mb-2 d-block">
                        <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/no-image.png" : p.ImageUrl)"
                             class="img-fluid rounded" style="height: 160px; width: 100%; object-fit: contain;"
                             alt="@p.Name" onerror="this.onerror=null; this.src='/images/no-image.png';">
                    </a>

                    <div class="card-body d-flex flex-column p-2">
                        <span class="category-badge">
                            <i class="bi bi-tag"></i> @(p.TypeOfProduct?.TypeOfProductName ?? "Без категорії")
                        </span>
                        <small class="text-muted" style="font-size: 10px;" title="Калорійність на 100г">
                            <i class="bi bi-fire text-orange"></i> @p.CaloriesPer100g ккал
                        </small>

                        <a asp-controller="Shop" asp-action="Details" asp-route-id="@p.ProductId" class="product-name mb-2 fw-bold text-dark">
                            @p.Name
                        </a>

                        <div class="mt-auto">
                            @if (p.ProductVariants != null && p.ProductVariants.Any())
                            {
                                var sortedV = p.ProductVariants.OrderBy(v => v.Price).ToList();
                                var inStockV = sortedV.Where(v => v.ProductBatches.Any(b => b.ExpiryDate > minDate && b.Stock > 0)).ToList();

                                var displayV = inStockV.Any()
                                ? (ViewBag.CurrentSort == "price_desc" ? inStockV.Last() : inStockV.First())
                                : sortedV.First();

                                bool isAvailable = inStockV.Contains(displayV);

                                <div class="mb-2">
                                    @if (sortedV.First().Price != sortedV.Last().Price)
                                    {
                                        <div class="price-range">@sortedV.First().Price.ToString("N0") - @sortedV.Last().Price.ToString("N0") ₴</div>
                                    }
                                    <div class="price-tag" id="price-@p.ProductId">
                                        @displayV.Price.ToString("N0") ₴
                                    </div>
                                </div>

                                <div class="d-flex flex-wrap gap-1 variant-container mb-3">
                                    @foreach (var v in sortedV)
                                    {
                                        bool hasStock = v.ProductBatches.Any(b => b.ExpiryDate > minDate && b.Stock > 0);
                                        <button class="btn btn-sm @(v == displayV ? "btn-success" : "btn-outline-secondary") @(hasStock ? "" : "opacity-50") py-0 px-1"
                                                style="font-size:10px;"
                                                onclick="updateCardState('price-@p.ProductId','status-@p.ProductId','@v.Price.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)',@(hasStock.ToString().ToLower()),this)">
                                            @v.Weight?.WeightValue @v.Weight?.Unit
                                        </button>
                                    }
                                </div>

                                <div class="d-flex justify-content-between align-items-end border-top pt-2">
                                    <small class="fw-bold @(isAvailable ? "text-success" : "text-muted")" id="status-@p.ProductId">
                                        @(isAvailable ? "В наявності" : "Закінчився")
                                    </small>
                                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@p.ProductId" class="btn btn-outline-success btn-cart rounded-circle p-2 border-0 bg-light">
                                        <i class="bi bi-cart3 fs-5"></i>
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@if (ViewBag.TotalPages > 1)
{
    <nav aria-label="Page navigation" class="mt-5">
        <ul class="pagination justify-content-center">

            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                   asp-route-searchString="@ViewBag.CurrentSearch"
                   asp-route-brandId="@ViewBag.CurrentBrand"
                   asp-route-typeId="@ViewBag.CurrentType"
                   asp-route-minRating="@ViewBag.CurrentRating"
                   asp-route-sortOrder="@ViewBag.CurrentSort">
                    &laquo; Назад
                </a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@i"
                       asp-route-searchString="@ViewBag.CurrentSearch"
                       asp-route-brandId="@ViewBag.CurrentBrand"
                       asp-route-typeId="@ViewBag.CurrentType"
                       asp-route-minRating="@ViewBag.CurrentRating"
                       asp-route-sortOrder="@ViewBag.CurrentSort">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                   asp-route-searchString="@ViewBag.CurrentSearch"
                   asp-route-brandId="@ViewBag.CurrentBrand"
                   asp-route-typeId="@ViewBag.CurrentType"
                   asp-route-minRating="@ViewBag.CurrentRating"
                   asp-route-sortOrder="@ViewBag.CurrentSort">
                    Вперед &raquo;
                </a>
            </li>
        </ul>
    </nav>
}


