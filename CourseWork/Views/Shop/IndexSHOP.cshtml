@model IEnumerable<CourseWork.Models.Product>
@{
    ViewData["Title"] = "Каталог товарів";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .product-card {
        transition: transform 0.2s;
        border: 1px solid #eee;
    }

        .product-card:hover {
            transform: translateY(-5px);
            border-color: #00a046;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

    .price-tag {
        font-size: 1.2rem;
        font-weight: bold;
        color: #f84147;
    }

    .product-name {
        text-decoration: none;
        color: #333;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 38px;
    }

        .product-name:hover {
            color: #00a046;
        }

    .stock-badge {
        font-size: 0.8rem;
    }

    .btn-cart:hover {
        background-color: #00a046;
        color: white;
    }
</style>

<div class="row mb-4 bg-light p-3 rounded border mx-0">
    <form method="get" id="filterForm" class="row g-3 align-items-center w-100 m-0">

        <div class="col-md-3">
            <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="🔍 Пошук..." />
        </div>

        <div class="col-md-2">
            <select name="brandId" class="form-select" asp-items="@(new SelectList(ViewBag.Brands, "BrandId", "BrandName", ViewBag.CurrentBrand))">
                <option value="">Всі бренди</option>
            </select>
        </div>

        <div class="col-md-2">
            <select name="typeId" class="form-select" asp-items="@(new SelectList(ViewBag.Types, "TypeOfProductId", "TypeOfProductName", ViewBag.CurrentType))">
                <option value="">Всі типи</option>
            </select>
        </div>

        <div class="col-md-2">
            <select name="minRating" class="form-select fw-bold text-success">
                <option value="" class="text-dark">Всі товари</option>
                <option value="1" selected="@(ViewBag.CurrentRating == 1)">Позитивні (>0)</option>
                <option value="5" selected="@(ViewBag.CurrentRating == 5)">Популярні (>5)</option>
                <option value="10" selected="@(ViewBag.CurrentRating == 10)">Топ (>10)</option>
                <option value="50" selected="@(ViewBag.CurrentRating == 50)">Хіти (>50)</option>
            </select>
        </div>

        <div class="col-md-2">
            <select name="sortOrder" class="form-select">
                <option value="newest" selected="@(ViewBag.CurrentSort == "newest")">Новинки</option>
                <option value="rating" selected="@(ViewBag.CurrentSort == "rating")">Популярні</option> 
                <option value="price_asc" selected="@(ViewBag.CurrentSort == "price_asc")">Дешевші</option>
                <option value="price_desc" selected="@(ViewBag.CurrentSort == "price_desc")">Дорожчі</option>
            </select>
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter"></i></button>
        </div>
    </form>
</div>

@if (ViewBag.CurrentRating != null && ViewBag.CurrentBrand != null)
{
    <div class="alert alert-info py-2 small mx-0 mb-4">
        <i class="bi bi-database-fill-gear"></i> Використано збережену процедуру <strong>sp_GetProductsByBrandAndRating</strong>
    </div>
}

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    @if (Model.Any())
    {
        @foreach (var p in Model)
        {
            <div class="col">
                <div class="card h-100 product-card p-2 position-relative">
                    @if (p.AggregateRating != 0)
                    {
                        var badgeClass = p.AggregateRating > 0 ? "bg-success" : "bg-danger";
                        var iconClass = p.AggregateRating > 0 ? "bi-hand-thumbs-up-fill" : "bi-hand-thumbs-down-fill";

                        <div class="position-absolute top-0 end-0 m-2 px-2 py-1 @badgeClass text-white rounded small fw-bold shadow-sm"
                             style="z-index: 10; opacity: 0.9;">
                            <i class="bi @iconClass"></i> @p.AggregateRating
                        </div>
                    }
                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@p.ProductId" class="text-center mb-2 d-block">
                        <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/no-image.png" : p.ImageUrl)"
                             class="img-fluid" style="height: 160px; object-fit: contain;" alt="@p.Name">
                    </a>

                    <div class="card-body d-flex flex-column p-2">
                        <a asp-controller="Shop" asp-action="Details" asp-route-id="@p.ProductId" class="product-name mb-2 fw-bold text-dark">
                            @p.Name
                        </a>

                        <div class="mt-auto">
                            @if (p.ProductVariants != null && p.ProductVariants.Any())
                            {
                                var sortedVariants = p.ProductVariants.OrderBy(v => v.Price).ToList();

                                var defaultVariant = sortedVariants.FirstOrDefault(v => v.ProductBatches.Sum(b => b.Stock) > 0)
                                ?? sortedVariants.First();

                                bool defaultInStock = defaultVariant.ProductBatches.Sum(b => b.Stock) > 0;

                                var priceId = "price-" + p.ProductId;
                                var statusId = "status-" + p.ProductId;

                                <div class="d-flex flex-wrap gap-1 variant-container mb-3">
                                    @foreach (var v in sortedVariants)
                                    {
                                        bool inStock = v.ProductBatches.Sum(b => b.Stock) > 0;

                                        <button class="btn btn-sm @(v == defaultVariant ? "btn-success" : "btn-outline-secondary") @(inStock ? "" : "opacity-50") py-0 px-1"
                                                style="font-size:11px;"
                                                onclick="updateCardState('@priceId','@statusId','@v.Price.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)',@(inStock.ToString().ToLower()),this)">
                                            @v.Weight?.WeightValue @v.Weight?.Unit
                                        </button>
                                    }
                                </div>

                                <div class="d-flex justify-content-between align-items-end border-top pt-2">
                                    <div>
                                        <div class="price-tag" id="@priceId">
                                            @defaultVariant.Price.ToString("N0") <span class="price-currency">₴</span>
                                        </div>

                                        <small class="fw-bold @(defaultInStock ? "text-success" : "text-muted")" id="@statusId">
                                            @(defaultInStock ? "В наявності" : "Закінчився")
                                        </small>
                                    </div>

                                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@p.ProductId" class="btn btn-outline-success btn-cart rounded-circle p-2 border-0 bg-light">
                                        <i class="bi bi-cart3 fs-5"></i>
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="text-muted small text-center py-2">Немає варіантів</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-warning text-center">
                <i class="bi bi-search fs-1 d-block mb-2"></i>
                Товарів не знайдено. Спробуйте змінити фільтри.
            </div>
        </div>
    }
</div>


