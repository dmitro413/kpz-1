@using CourseWork.Core.Models
@model CourseWork.Core.Models.User
@{
    ViewData["Title"] = "Мій профіль";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isStaff = User.IsInRole("Admin") || User.IsInRole("Manager");
}

<div class="container mt-4">
    <h2><i class="bi bi-person-circle"></i> Мій кабінет</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row mt-4">
        <div class="col-md-3">
            <div class="list-group shadow-sm">
                <a asp-action="Index" class="list-group-item list-group-item-action active">
                    <i class="bi bi-person-fill"></i> Особисті дані
                </a>
                <a asp-action="Orders" class="list-group-item list-group-item-action">
                    <i class="bi bi-box-seam"></i> Мої замовлення
                </a>
            </div>
        </div>

        <div class="col-md-9">
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-light fw-bold">Особиста інформація</div>
                <div class="card-body">
                    <form asp-action="UpdateInfo" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email (Логін)</label>
                            <input asp-for="Email" class="form-control bg-light" readonly />
                            <small class="text-muted">Email змінити неможливо.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label">ПІБ</label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label">Телефон</label>
                            <input asp-for="Phone" class="form-control" placeholder="+380..." />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Зберегти дані
                        </button>
                    </form>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-warning text-dark fw-bold">Зміна пароля</div>
                <div class="card-body">
                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">Старий пароль</label>
                            <input name="OldPassword" type="password" class="form-control" required />
                            @Html.ValidationMessage("OldPassword", new { @class = "text-danger small" })
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Новий пароль</label>
                                <input name="NewPassword" type="password" class="form-control" required minlength="6" />
                                @Html.ValidationMessage("NewPassword", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Повторіть новий</label>
                                <input name="ConfirmPassword" type="password" class="form-control" required />
                                @Html.ValidationMessage("ConfirmPassword", new { @class = "text-danger small" })
                            </div>
                        </div>
                        <button type="submit" class="btn btn-warning">Змінити пароль</button>
                    </form>
                </div>
            </div>

            @if (!isStaff)
            {
                <div class="card shadow-sm border-danger mt-5">
                    <div class="card-header bg-danger text-white">
                        <i class="bi bi-exclamation-triangle-fill"></i> Небезпечна зона
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">Видалення акаунту</h5>
                        <p class="card-text text-muted">
                            Ця дія незворотна. Ваші відгуки будуть видалені, а історія покупок знеособлена.
                        </p>

                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">
                            Видалити мій акаунт
                        </button>
                    </div>
                </div>

                <div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header bg-danger text-white">
                                <h5 class="modal-title">Видалення акаунту</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <p class="fw-bold">Ви впевнені, що хочете видалити свій профіль?</p>
                                <p>Доступ до акаунту буде втрачено назавжди.</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>

                                <form asp-action="DeleteAccount" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger">Так, видалити</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info mt-5 shadow-sm">
                    <i class="bi bi-info-circle-fill"></i> Ви увійшли як співробітник (@Model.Role). Видалення робочого акаунту через цю форму неможливе.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}