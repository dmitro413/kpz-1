@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var activeTab = localStorage.getItem('activeTab');
            if (activeTab) {
                var tabTrigger = new bootstrap.Tab(document.querySelector(activeTab));
                tabTrigger.show();
            }

            var tabLinks = document.querySelectorAll('button[data-bs-toggle="tab"]');
            tabLinks.forEach(function (tabLink) {
                tabLink.addEventListener('shown.bs.tab', function (event) {
                    localStorage.setItem('activeTab', '#' + event.target.id);
                });
            });
        });

        const deleteBrandModal = document.getElementById('deleteBrandModal');
        if (deleteBrandModal) {
            deleteBrandModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const id = button.getAttribute('data-brand-id');
                const name = button.getAttribute('data-brand-name');
                document.getElementById('deleteBrandName').textContent = name;
                document.getElementById('deleteBrandForm').action = '/Brands/Delete/' + id;
            });
        }

        const deleteProductModal = document.getElementById('deleteProductModal');
        if (deleteProductModal) {
            deleteProductModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                
                const productId = button.getAttribute('data-product-id');
                const productName = button.getAttribute('data-product-name');
                
                const modalName = deleteProductModal.querySelector('#modalProductName');
                const deleteForm = deleteProductModal.querySelector('#deleteProductForm');
                modalName.textContent = productName;
                
                deleteForm.action = '/Products/Delete/' + productId;
            });
        }

        const deleteVariantModal = document.getElementById('deleteVariantModal');
        if (deleteVariantModal) {
            deleteVariantModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const id = button.getAttribute('data-variant-id');
                const info = button.getAttribute('data-variant-info');
                document.getElementById('deleteVariantInfo').textContent = info;
                document.getElementById('deleteVariantForm').action = '/Variants/Delete/' + id;
            });
        }

        const deleteTypeModal = document.getElementById('deleteTypeModal');
        if (deleteTypeModal) {
            deleteTypeModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const id = button.getAttribute('data-type-id');
                const name = button.getAttribute('data-type-name');
                document.getElementById('deleteTypeName').textContent = name;
                document.getElementById('deleteTypeForm').action = '/Types/Delete/' + id;
            });
        }
    
    const deleteWeightModal = document.getElementById('deleteWeightModal');
        if (deleteWeightModal) {
            deleteWeightModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const id = button.getAttribute('data-weight-id');
                const info = button.getAttribute('data-weight-val');

                document.getElementById('deleteWeightInfo').textContent = info;
                document.getElementById('deleteWeightForm').action = '/Weights/Delete/' + id;
            });
        }
    const deleteUserModal = document.getElementById('deleteUserModal');
        if (deleteUserModal) {
            deleteUserModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const id = button.getAttribute('data-user-id');
                const name = button.getAttribute('data-user-name');
                document.getElementById('deleteUserName').textContent = name;
                document.getElementById('deleteUserForm').action = '/Users/Delete/' + id;
                });
        }
    const deleteReviewModal = document.getElementById('deleteReviewModal');
        if (deleteReviewModal) {
               deleteReviewModal.addEventListener('show.bs.modal', function (event) {
               const button = event.relatedTarget;
               const id = button.getAttribute('data-review-id');
               document.getElementById('deleteReviewForm').action = '/Reviews/Delete/' + id;
               });
        }
        const deleteBatchModal = document.getElementById('deleteBatchModal');
        if (deleteBatchModal) {
              deleteBatchModal.addEventListener('show.bs.modal', function (event) {
              const button = event.relatedTarget;
              
              const id = button.getAttribute('data-batch-id');
              const productName = button.getAttribute('data-product-name');
              const variantInfo = button.getAttribute('data-variant-info');
              const stock = button.getAttribute('data-stock');
              document.getElementById('deleteBatchProduct').textContent = productName;
              document.getElementById('deleteBatchVariant').textContent = variantInfo;
              document.getElementById('deleteBatchStock').textContent = stock;
              
              document.getElementById('deleteBatchForm').action = '/Batches/Delete/' + id;
              });
        }
        const deleteOrderModal = document.getElementById('deleteOrderModal');
        if (deleteOrderModal) {
            deleteOrderModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget; 
            const id = button.getAttribute('data-order-id'); 

            document.getElementById('delOrderNum').textContent = '#' + id;
            document.getElementById('delOrderIdInput').value = id;
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            const urlParams = new URLSearchParams(window.location.search);
            const activeTabId = urlParams.get('activeTab');

            if (activeTabId) {
                const tabButton = document.querySelector(`button[data-bs-target="#${activeTabId}"]`);
                if (tabButton) {
                    var tab = new bootstrap.Tab(tabButton);
                    tab.show();
                }
            }
        });
    </script>
} 