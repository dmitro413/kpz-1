@using CourseWork.Models
@using System.Linq
@using System.Security.Claims 
@model CourseWork.Models.DashboardViewModel
@{
    ViewData["Title"] = "База даних магазину";
}

<div class="container">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mt-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mt-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <h2 class="my-4"><i class="bi bi-database-gear"></i> Керування даними</h2>

    <ul class="nav nav-tabs" id="myTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="brand-tab" data-bs-toggle="tab" data-bs-target="#tabBrands" type="button" role="tab" aria-controls="brands" aria-selected="true">
                <i class="bi bi-award"></i> Бренди
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="type-tab" data-bs-toggle="tab" data-bs-target="#tabTypes" type="button" role="tab">
                <i class="bi bi-list-ul"></i> Типи
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="weight-tab" data-bs-toggle="tab" data-bs-target="#tabWeights" type="button" role="tab">
                <i class="bi bi-speedometer2"></i> Вага
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="product-tab" data-bs-toggle="tab" data-bs-target="#tabProducts" type="button" role="tab" aria-controls="products" aria-selected="false">
                <i class="bi bi-box-seam"></i> Товари
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="variant-tab" data-bs-toggle="tab" data-bs-target="#tabVariants" type="button" role="tab" aria-controls="variants" aria-selected="false">
                <i class="bi bi-tags"></i> Варіанти
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="batch-tab" data-bs-toggle="tab" data-bs-target="#tabBatches" type="button" role="tab" aria-controls="batches" aria-selected="false">
                <i class="bi bi-boxes"></i> Склад (Партії)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="user-tab" data-bs-toggle="tab" data-bs-target="#tabUsers" type="button" role="tab">
                <i class="bi bi-people"></i> Користувачі
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="review-tab" data-bs-toggle="tab" data-bs-target="#tabReviews" type="button" role="tab">
                <i class="bi bi-chat-quote"></i> Відгуки
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="reports-tab" data-bs-toggle="tab" data-bs-target="#tabReports" type="button" role="tab">
                <i class="bi bi-graph-up-arrow"></i> Звіти
            </button>
        <li class="nav-item">
            <button class="nav-link" id="orders-tab" data-bs-toggle="tab" data-bs-target="#tabOrders">
                <i class="bi bi-truck"></i> Замовлення <span class="badge bg-danger">@Model.Orders.Count(o => o.StatusId == 1)</span>
            </button>
        </li>
        </li>
    </ul>

    <div class="tab-content pt-4" id="myTabContent">

        <!--БРЕНДИ -->
        <div class="tab-pane fade show active" id="tabBrands" role="tabpanel" aria-labelledby="brand-tab">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3>Список брендів <span class="badge bg-secondary">@Model.TotalBrands</span></h3>
                <a asp-controller="Brands" asp-action="Create" class="btn btn-primary shadow-sm">
                    <i class="bi bi-plus-circle"></i> Додати бренд
                </a>
            </div>

            <div class="table-responsive shadow-sm rounded">
                <table class="table table-bordered table-striped table-hover align-middle mb-0">
                    <thead class="table-primary text-center">
                        <tr>
                            <th style="width: 80px;">ID</th>
                            <th>Бренд</th>
                            <th>Країна</th>
                            <th style="width: 140px;">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Brands.Any())
                        {
                            foreach (var r in Model.Brands)
                            {
                                <tr>
                                    <td class="text-center">@r.BrandId</td>
                                    <td><strong>@r.BrandName</strong></td>
                                    <td>
                                        <i class="bi bi-geo-alt text-muted"></i> @r.Country
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-controller="Brands" asp-action="Edit" asp-route-id="@r.BrandId" class="btn btn-warning btn-sm" title="Редагувати">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                             @if (User.IsInRole("Admin")){
                                            <button type="button"
                                                    class="btn btn-danger btn-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteBrandModal"
                                                    data-brand-id="@r.BrandId"
                                                    data-brand-name="@r.BrandName"
                                                    title="Видалити">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center py-4 text-muted">Дані відсутні</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <!--ТИПИ ПРОДУКТІВ-->
        <div class="tab-pane fade" id="tabTypes" role="tabpanel" aria-labelledby="type-tab">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3>Категорії товарів <span class="badge bg-secondary">@Model.TotalTypes</span></h3>
                <a asp-controller="Types" asp-action="Create" class="btn btn-secondary shadow-sm">
                    <i class="bi bi-plus-circle"></i> Додати тип
                </a>
            </div>

            <div class="table-responsive shadow-sm rounded">
                <table class="table table-bordered table-striped table-hover align-middle mb-0">
                    <thead class="table-secondary text-center">
                        <tr>
                            <th style="width: 80px;">ID</th>
                            <th>Назва категорії</th>
                            <th style="width: 140px;">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Types.Any())
                        {
                            foreach (var t in Model.Types)
                            {
                                <tr>
                                    <td class="text-center">@t.TypeOfProductId</td>
                                    <td><strong>@t.TypeOfProductName</strong></td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-controller="Types" asp-action="Edit" asp-route-id="@t.TypeOfProductId" class="btn btn-warning btn-sm">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-controller="Types" asp-action="Delete" asp-route-id="@t.TypeOfProductId" method="post" style="display:inline;" onsubmit="return confirm('Видалити цю категорію?');">
                                                @Html.AntiForgeryToken()
                                                @if (User.IsInRole("Admin"))
                                                {
                                                    <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteTypeModal"
                                                    data-type-id="@t.TypeOfProductId" data-type-name="@t.TypeOfProductName"title="Видалити">
                                                    <i class="bi bi-trash"></i>
                                                </button>}
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="text-center py-4 text-muted">Категорій немає</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <!--ВАГА-->
        <div class="tab-pane fade" id="tabWeights" role="tabpanel" aria-labelledby="weight-tab">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3>Одиниці виміру <span class="badge bg-secondary">@Model.TotalWeights</span></h3>
                <a asp-controller="Weights" asp-action="Create" class="btn btn-dark shadow-sm">
                    <i class="bi bi-plus-circle"></i> Додати вагу
                </a>
            </div>

            <div class="table-responsive shadow-sm rounded">
                <table class="table table-bordered table-striped table-hover align-middle mb-0">
                    <thead class="table-dark text-center">
                        <tr>
                            <th style="width: 80px;">ID</th>
                            <th>Значення</th>
                            <th>Одиниця</th>
                            <th style="width: 140px;">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Weights.Any())
                        {
                            foreach (var w in Model.Weights)
                            {
                                <tr>
                                    <td class="text-center">@w.WeightId</td>
                                    <td class="text-center fw-bold">@w.WeightValue</td>
                                    <td class="text-center">@w.Unit</td>
                                    <td class="text-center">
                                        @if (User.IsInRole("Admin")){

                                        <div class="btn-group" role="group">
                                            <a asp-controller="Weights" asp-action="Edit" asp-route-id="@w.WeightId" class="btn btn-warning btn-sm">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                                <button type="button"
                                                class="btn btn-danger btn-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteWeightModal"
                                                    data-weight-id="@w.WeightId"
                                                    data-weight-val="@w.WeightValue @w.Unit"
                                                    title="Видалити">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center py-4 text-muted">Список порожній</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tab-pane fade" id="tabProducts" role="tabpanel" aria-labelledby="product-tab">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3>Товари <span class="badge bg-secondary">@Model.TotalProducts</span></h3>
                <a asp-controller="Products" asp-action="Create" class="btn btn-success shadow-sm">
                    <i class="bi bi-plus-circle"></i> Додати товар
                </a>
            </div>

            <!-- ФОРМА ПОШУКУ ТА ФІЛЬТРАЦІЇ -->
            <form method="get" asp-controller="Home" asp-action="Index" class="row g-2 mb-4 bg-light p-3 rounded border shadow-sm">
                <input type="hidden" name="page" value="1" />

                <div class="col-md-3">
                    <input type="text" name="searchString" value="@Model.CurrentSearch" class="form-control" placeholder="🔍 Пошук за назвою..." />
                </div>
                <div class="col-md-3">
                    <select name="brandId" asp-items="@Model.BrandList" class="form-select">
                        <option value="">-- Всі Бренди --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="typeId" asp-items="@Model.TypeList" class="form-select">
                        <option value="">-- Всі Типи --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-secondary w-100">
                        <i class="bi bi-search"></i> Шукати
                    </button>
                </div>

                <div class="col-12 mt-2 border-top pt-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="showDeletedCheck" name="showDeleted" value="true" @(Model.ShowDeleted ? "checked" : "") onchange="this.form.submit()">
                        <label class="form-check-label fw-bold text-muted" for="showDeletedCheck">
                            <i class="bi bi-trash"></i> Показувати архівні (видалені) товари
                        </label>
                    </div>
                </div>
            </form>

            @if (Model.Products.Any())
            {
                <div class="table-responsive shadow-sm rounded">
                    <table class="table table-bordered table-striped table-hover align-middle mb-0">
                        <thead class="table-success text-center">
                            <tr>
                                <th style="width: 90px;">Фото</th>
                                <th style="width: 60px;">ID</th>
                                <th style="width: 20%;">Назва</th>
                                <th style="width: 130px;">Бренд</th>
                                <th style="width: 130px;">Тип</th>
                                <th style="width: 110px;">Калорії</th>
                                <th style="width: 25%;">Опис</th>
                                <th style="width: 100px;">Оновлено</th>
                                <th style="width: 160px;">Дії</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Products)
                            {
                                <tr class="@(p.IsDeleted ? "table-danger" : "")">
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(p.ImageUrl))
                                        {
                                            <img src="@p.ImageUrl" alt="@p.Name" class="rounded border" style="width: 60px; height: 60px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded d-flex align-items-center justify-content-center text-muted border mx-auto" style="width: 60px; height: 60px; font-size: 10px;">
                                                No IMG
                                            </div>
                                        }
                                    </td>
                                    <td class="text-center">@p.ProductId</td>
                                    <td><strong>@p.Name</strong></td>
                                    <td>
                                        @if (p.Brand != null)
                                        {
                                            <span class="badge bg-primary">@p.Brand.BrandName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (p.TypeOfProduct != null)
                                        {
                                            <span class="badge bg-info text-dark">@p.TypeOfProduct.TypeOfProductName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (p.CaloriesPer100g > 0)
                                        {
                                            <span>@p.CaloriesPer100g.ToString("F1")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(p.Description))
                                        {
                                            var shortDesc = p.Description.Length > 50 ? p.Description.Substring(0, 50) + "..." : p.Description;
                                            <small class="text-muted">@shortDesc</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center small text-muted">
                                        @(p.UpdatedAt.HasValue ? p.UpdatedAt.Value.ToString("dd.MM HH:mm") : "—")
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group" role="group">

                                            @if (p.IsDeleted)
                                            {
                                                if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                                {
                                                    <form asp-controller="Products" asp-action="Restore" asp-route-id="@p.ProductId" method="post" style="display:inline;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="showDeleted" value="@Model.ShowDeleted.ToString().ToLower()" />

                                                        <button type="submit" class="btn btn-success btn-sm" title="Відновити товар">
                                                            <i class="bi bi-arrow-counterclockwise"></i> Відновити
                                                        </button>
                                                    </form>
                                                }

                                                if (User.IsInRole("Admin"))
                                                {
                                                    <form asp-controller="Products" asp-action="HardDelete" asp-route-id="@p.ProductId" method="post" style="display:inline;" onsubmit="return confirm('Видалити остаточно з бази? Це незворотно!');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-dark btn-sm ms-1" title="Видалити повністю">
                                                            <i class="bi bi-x-lg"></i>
                                                        </button>
                                                    </form>
                                                }
                                            }
                                            else
                                            {
                                                <a asp-controller="Products" asp-action="Edit" asp-route-id="@p.ProductId" class="btn btn-warning btn-sm" title="Редагувати">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                @if (User.IsInRole("Admin"))
                                                {
                                                    <button type="button"
                                                            class="btn btn-danger btn-sm"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#deleteProductModal"
                                                            data-product-id="@p.ProductId"
                                                            data-product-name="@p.Name"
                                                            title="Перемістити в архів">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Page navigation" class="mt-4">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-controller="Home" asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage - 1)"
                                   asp-route-searchString="@Model.CurrentSearch"
                                   asp-route-brandId="@Model.CurrentBrandId"
                                   asp-route-typeId="@Model.CurrentTypeId"
                                   asp-route-showDeleted="@Model.ShowDeleted">
                                    Попередня
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                    <a class="page-link" asp-controller="Home" asp-action="Index"
                                       asp-route-page="@i"
                                       asp-route-searchString="@Model.CurrentSearch"
                                       asp-route-brandId="@Model.CurrentBrandId"
                                       asp-route-typeId="@Model.CurrentTypeId"
                                       asp-route-showDeleted="@Model.ShowDeleted">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-controller="Home" asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-searchString="@Model.CurrentSearch"
                                   asp-route-brandId="@Model.CurrentBrandId"
                                   asp-route-typeId="@Model.CurrentTypeId"
                                   asp-route-showDeleted="@Model.ShowDeleted">
                                    Наступна
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="alert alert-info text-center mt-4">
                    <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                    <p class="mt-2">Товари не знайдено за вашим запитом.</p>
                </div>
            }
        </div>

        <!--ВАРІАНТИ-->
        <div class="tab-pane fade" id="tabVariants" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3>Варіанти (Ціни) <span class="badge bg-secondary">@Model.TotalVariants</span></h3>

                <form method="get" asp-action="Index" class="d-flex gap-2">
                    <input type="hidden" name="page" value="1" />
                    <input type="text" name="variantSearch" value="@Model.VariantSearch" class="form-control form-control-sm" placeholder="Назва товару..." style="width: 200px;">
                    <button type="submit" class="btn btn-sm btn-dark">Знайти</button>
                </form>

                <a asp-controller="Variants" asp-action="Create" class="btn btn-warning text-dark btn-sm shadow-sm">
                    <i class="bi bi-plus-circle"></i> Додати варіант
                </a>
            </div>

            <div class="table-responsive shadow-sm rounded">
                <table class="table table-bordered table-striped table-hover align-middle mb-0">
                    <thead class="table-warning text-center">
                        <tr>
                            <th style="width: 80px;">ID</th>
                            <th>Товар</th>
                            <th>Вага/Об'єм</th>
                            <th>Ціна (грн)</th>
                            <th style="width: 100px;">Оновлено</th>
                            <th style="width: 140px;">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.Variants)
                        {
                            <tr>
                                <td class="text-center">@v.VariantId</td>
                                <td><strong>@(v.Product?.Name ?? "—")</strong></td>
                                <td class="text-center">@v.Weight?.WeightValue @v.Weight?.Unit</td>
                                <td class="fw-bold text-success text-center">@v.Price.ToString("N2") ₴</td>
                                <td class="text-center small text-muted">
                                    @(v.UpdatedAt.HasValue ? v.UpdatedAt.Value.ToString("dd.MM HH:mm") : "—")
                                </td>
                                <td class="text-center">
                                    <div class="btn-group">
                                        <a asp-controller="Variants" asp-action="Edit" asp-route-id="@v.VariantId" class="btn btn-warning btn-sm"><i class="bi bi-pencil"></i></a>
                                        <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteVariantModal" data-variant-id="@v.VariantId" data-variant-info="@v.Product?.Name">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>                            
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.VariantTotalPages > 1)
            {
                <nav class="mt-3">
                    <ul class="pagination pagination-sm justify-content-center">
                        @for (int i = 1; i <= Model.VariantTotalPages; i++)
                        {
                            <li class="page-item @(Model.VariantCurrentPage == i ? "active" : "")">
                                <a class="page-link" asp-route-variantPage="@i" asp-route-variantSearch="@Model.VariantSearch">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
        <!--ПАРТІЇ-->
        <div class="tab-pane fade" id="tabBatches" role="tabpanel" aria-labelledby="batch-tab">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3>Партії на складі <span class="badge bg-secondary">@Model.TotalBatches</span></h3>
                <a asp-controller="Batches" asp-action="Create" class="btn btn-info text-white shadow-sm">
                    <i class="bi bi-plus-circle"></i> Прийняти поставку
                </a>
            </div>

            <div class="table-responsive shadow-sm rounded">
                <table class="table table-bordered table-striped table-hover align-middle mb-0">
                    <thead class="table-info text-center">
                        <tr>
                            <th>ID</th>
                            <th>Товар (Варіант)</th>
                            <th>Залишок</th>
                            <th>Постачальник</th>
                            <th>Дата вироб.</th>
                            <th>Придатний до</th>
                            <th>Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Batches.Any())
                        {
                            foreach (var b in Model.Batches)
                            {
                                bool isExpired = b.ExpiryDate < DateOnly.FromDateTime(DateTime.Now);
                                string rowClass = isExpired ? "table-danger" : "";

                                <tr class="@rowClass">
                                    <td class="text-center">@b.BatchId</td>
                                    <td>
                                        @(b.Variant?.Product?.Name ?? "ID:" + b.VariantId)
                                        <small class="text-muted d-block">
                                            (@(b.Variant?.Weight?.WeightValue) @(b.Variant?.Weight?.Unit))
                                        </small>
                                    </td>
                                    <td class="text-center fw-bold">
                                        @b.Stock шт.
                                    </td>
                                    <td>@b.SupplierName</td>
                                    <td class="text-center">@b.ManufactureDate.ToShortDateString()</td>
                                    <td class="text-center">
                                        @b.ExpiryDate.ToShortDateString()
                                        @if (isExpired)
                                        {
                                            <br />

                                            <span class="badge bg-danger">Протерміновано!</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-controller="Batches" asp-action="Edit" asp-route-id="@b.BatchId" class="btn btn-warning btn-sm me-1" title="Редагувати">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-danger btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteBatchModal"
                                                data-batch-id="@b.BatchId"
                                                data-product-name="@(b.Variant?.Product?.Name)"
                                                data-variant-info="@(b.Variant?.Weight?.WeightValue) @(b.Variant?.Weight?.Unit)"
                                                data-stock="@b.Stock"
                                                title="Видалити партію">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="text-center py-4 text-muted">Склад порожній</td></tr>
                        }
                    </tbody>
                </table>
                @if (Model.TotalBatches > Model.PageSize)
                {
                    int totalBatchPages = (int)Math.Ceiling((double)Model.TotalBatches / Model.PageSize);
                    <nav aria-label="Page navigation" class="mt-3">
                        <ul class="pagination pagination-sm justify-content-center">
                            @for (int i = 1; i <= totalBatchPages; i++)
                            {
                                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = i, activeTab = "tabBatches" })">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        </div>
        <!--Користувачі-->
