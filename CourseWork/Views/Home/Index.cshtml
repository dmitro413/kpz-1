                        <nav aria-label="Page navigation" class="mt-3">
                            <ul class="pagination pagination-sm justify-content-center">
                                @for (int i = 1; i <= totalReviewPages; i++)
                                {
                                    <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { page = i, activeTab = "tabReviews" })">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
            </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-shield-lock-fill text-danger" style="font-size: 4rem;"></i>
                    </div>
                    <h3 class="text-danger fw-bold">Доступ заборонено</h3>
                    <p class="text-muted lead">
                        Перегляд списку відгуків доступний лише адміністрації.
                    </p>
                </div>
            }
        </div>
        <!-- Замовлення-->
        <div class="tab-pane fade" id="tabOrders" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3>Замовлення</h3>

                <form method="get" asp-action="Index" class="d-flex gap-2">
                    <input type="hidden" name="activeTab" value="tabOrders" />
                    <input type="hidden" name="page" value="1" />

                    <select name="orderStatusId" class="form-select form-select-sm" style="width: 150px;">
                        <option value="">-- Всі статуси --</option>
                        @foreach (var s in Model.OrderStatuses)
                        {
                            <option value="@s.StatusId" selected="@(Model.CurrentOrderStatusId == s.StatusId)">
                                @s.StatusName
                            </option>
                        }
                    </select>

                    <input type="text" name="orderSearch" value="@Model.OrderSearch" class="form-control form-control-sm" placeholder="№, ім'я або телефон..." style="width: 200px;">
                    <button type="submit" class="btn btn-sm btn-dark">Знайти</button>
                </form>
            </div>

            <div class="table-responsive shadow-sm rounded">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Дата</th>
                            <th>Клієнт</th>
                            <th>Сума</th>
                            <th>Статус</th>
                            <th>Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.Orders)
                        {
                            <tr>
                                <td>#@o.OrderId</td>
                                <td>@o.OrderDate?.ToString("g")</td>
                                <td>
                                    <strong>@o.CustomerName</strong><br />
                                    <small class="text-muted">@o.CustomerPhone</small>
                                </td>
                                <td class="fw-bold text-success">
                                    @o.OrderDetails.Sum(x => x.Quantity * x.UnitPrice).ToString("N0") ₴
                                </td>
                                <td>
                                    <form asp-controller="Orders" asp-action="UpdateStatus" method="post" class="d-flex">
                                        <input type="hidden" name="orderId" value="@o.OrderId" />
                                        <select name="statusId" class="form-select form-select-sm"
                                                onchange="this.form.submit()"
                                                style="width: 130px; border-color: @(o.StatusId == 3 ? "green" : "orange")">
                                            @foreach (var s in Model.OrderStatuses)
                                            {
                                                <option value="@s.StatusId" selected="@(s.StatusId == o.StatusId)">
                                                    @s.StatusName
                                                </option>
                                            }
                                        </select>
                                    </form>
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-sm btn-info text-white" type="button" data-bs-toggle="collapse" data-bs-target="#details-@o.OrderId">
                                            Деталі
                                        </button>
                                            <button type="button" class="btn btn-sm btn-danger"
                                                    data-bs-toggle="modal" data-bs-target="#deleteOrderModal"
                                                    data-order-id="@o.OrderId">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                    </div>
                                </td>
                            </tr>
                            <tr class="collapse bg-light" id="details-@o.OrderId">
                                <td colspan="6" class="p-3">
                                    <strong>Адреса:</strong> @o.DeliveryAddress <br />
                                    <strong>Товари:</strong>
                                    <ul>
                                        @foreach (var d in o.OrderDetails)
                                        {
                                            <li>@d.Variant?.Product?.Name (@d.Quantity шт. x @d.UnitPrice ₴)</li>
                                        }
                                    </ul>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.OrderTotalPages > 1)
            {
                <nav class="mt-3">
                    <ul class="pagination pagination-sm justify-content-center">
                        @for (int i = 1; i <= Model.OrderTotalPages; i++)
                        {
                            <li class="page-item @(Model.OrderCurrentPage == i ? "active" : "")">
                                <a class="page-link"
                                   href="@Url.Action("Index", new {
                           orderPage = i,
                           orderSearch = Model.OrderSearch,
                           orderStatusId = Model.CurrentOrderStatusId, 
                           activeTab = "tabOrders"
                       })">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>


 
        
      
        <!--АНАЛІТИКА-->
        <div class="tab-pane fade" id="tabReports" role="tabpanel" aria-labelledby="reports-tab">

            <!--ПАНЕЛЬ НАЛАШТУВАНЬ-->
            <div class="card bg-light border mb-4">
                <div class="card-body py-3">
                    <form method="get" id="reportForm" class="row g-3 align-items-end">
                        <input type="hidden" name="searchString" value="@Model.CurrentSearch" />
                        <input type="hidden" name="brandId" value="@Model.CurrentBrandId" />
                        <input type="hidden" name="typeId" value="@Model.CurrentTypeId" />

                        <!--Топ Брендів-->
                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-muted">Топ брендів:</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white"><i class="bi bi-trophy"></i></span>
                                <input type="number" name="reportTopCount" value="@Model.ReportTopCount" class="form-control" min="1" max="20">
                            </div>
                        </div>

                        <!--Дефіцит-->
                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-muted">Поріг дефіциту (шт):</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white"><i class="bi bi-box-seam"></i></span>
                                <input type="number" name="reportLowStock" value="@Model.ReportLowStockThreshold" class="form-control" min="0">
                            </div>
                        </div>

                        <!-- Термін придатності -->
                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-muted">Спливають через (днів):</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white"><i class="bi bi-hourglass-split"></i></span>
                                <input type="number" name="reportDaysExpiry" value="@Model.ReportDaysUntilExpiry" class="form-control" min="1">
                            </div>
                        </div>

                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary btn-sm w-100">
                                <i class="bi bi-arrow-clockwise"></i> Оновити всі звіти
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!--НАВІГАЦІЯ-->
            <ul class="nav nav-pills mb-3 justify-content-center" id="reportTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="sales-subtab" data-bs-toggle="pill" data-bs-target="#pills-sales" type="button" role="tab">
                        <i class="bi bi-graph-up"></i> Продажі
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="stock-subtab" data-bs-toggle="pill" data-bs-target="#pills-stock" type="button" role="tab">
                        <i class="bi bi-exclamation-triangle"></i> Дефіцит
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="expiry-subtab" data-bs-toggle="pill" data-bs-target="#pills-expiry" type="button" role="tab">
                        <i class="bi bi-calendar-x"></i> Терміни придатності
                        @if (Model.ExpiringBatches.Any())
                        {
                            <span class="badge bg-danger ms-1">@Model.ExpiringBatches.Count()</span>
                        }
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="pills-tabContent">

                <!-- ПРОДАЖІ-->
                <div class="tab-pane fade show active" id="pills-sales" role="tabpanel">
                    <div class="card shadow-sm border-0">
                        <div class="card-body p-0">
                            <table class="table table-striped mb-0">
                                <thead class="table-success">
                                    <tr>
                                        <th>Бренд</th>
                                        <th class="text-center">Продано шт.</th>
                                        <th class="text-end">Оборот</th>
                                        <th class="text-end">Прибуток</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.TopBrands.Any())
                                    {
                                        @foreach (var item in Model.TopBrands)
                                        {
                                            decimal margin = item.TotalRevenue > 0 ? (item.EstimatedProfit / item.TotalRevenue) * 100 : 0;
                                            <tr>
                                                <td><strong>@item.BrandName</strong></td>
                                                <td class="text-center">@item.SalesCount</td>
                                                <td class="text-end">@item.TotalRevenue.ToString("N0") ₴</td>
                                                <td class="text-end fw-bold text-success">
                                                    @item.EstimatedProfit.ToString("N0") ₴
                                                    <small class="text-muted d-block" style="font-size: 10px;">(@margin.ToString("F1")%)</small>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr><td colspan="4" class="text-center py-3">Немає даних</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!--ДЕФІЦИТ-->
                <div class="tab-pane fade" id="pills-stock" role="tabpanel">
                    <div class="card shadow-sm border-0">
                        <div class="card-body p-0">
                            <table class="table table-hover mb-0">
                                <thead class="table-danger">
                                    <tr>
                                        <th>Товар</th>
                                        <th>Бренд</th>
                                        <th class="text-center">Залишок</th>
                                        <th class="text-center">Дія</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.LowStockProducts.Any())
                                    {
                                        @foreach (var item in Model.LowStockProducts)
                                        {
                                            <tr>
                                                <td>@item.Name</td>
                                                <td class="text-muted">@item.BrandName</td>
                                                <td class="text-center text-danger fw-bold">@item.TotalStock шт.</td>
                                                <td class="text-center">
                                                    <a asp-controller="Batches" asp-action="Create" class="btn btn-sm btn-outline-danger"><i class="bi bi-cart-plus"></i></a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr><td colspan="4" class="text-center text-success py-3"><i class="bi bi-check-lg"></i> Все в наявності</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- ТЕРМІНИ-->
                <div class="tab-pane fade" id="pills-expiry" role="tabpanel">
                    <div class="card shadow-sm border-0">
                        <div class="card-body p-0">
                            <table class="table table-hover mb-0">
                                <thead class="table-warning">
                                    <tr>
                                        <th>Товар</th>
                                        <th>Партія ID</th>
                                        <th>Вага</th>
                                        <th class="text-center">Виготовлено</th>
                                        <th class="text-center">Придатний до</th>
                                        <th class="text-center">Залишок</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.ExpiringBatches.Any())
                                    {
                                        @foreach (var b in Model.ExpiringBatches)
                                        {
                                            bool isExpired = b.ExpiryDate < DateOnly.FromDateTime(DateTime.Now);

                                            <tr class="@(isExpired ? "table-danger" : "")">
                                                <td>
                                                    <strong>@(b.Variant?.Product?.Name ?? "Видалений товар")</strong>
                                                    <small class="d-block text-muted">@(b.Variant?.Product?.Brand?.BrandName)</small>
                                                </td>
                                                <td>#@b.BatchId</td> 
                                                <td>
                                                    @(b.Variant?.Weight?.WeightValue) @(b.Variant?.Weight?.Unit)
                                                </td>
                                                <td class="text-center">@b.ManufactureDate</td>
                                                <td class="text-center fw-bold">
                                                    @b.ExpiryDate
                                                    @if (b.ExpiryDate < DateOnly.FromDateTime(DateTime.Now))
                                                    {
                                                        <span class="badge bg-danger">ПРОСТРОЧЕНО</span>
                                                    }
                                                </td>
                                                <td class="text-center">@b.Stock шт.</td> 
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr><td colspan="6" class="text-center text-success py-3"><i class="bi bi-check-lg"></i> Немає проблемних партій у найближчі @Model.ReportDaysUntilExpiry днів</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>                
            </div>
