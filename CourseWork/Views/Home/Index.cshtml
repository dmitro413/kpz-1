            <div class="table-responsive shadow-sm rounded">
                <table class="table table-bordered table-striped table-hover align-middle mb-0">
                    <thead class="table-primary text-center">
                        <tr>
                            <th>ID</th>
                            <th>ПІБ</th>
                            <th>Email</th>
                            <th>Телефон</th>
                            <th>Роль</th>
                            <th>Реєстрація</th>
                            <th>Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Users.Any())
                        {
                            foreach (var u in Model.Users)
                            {
                                    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
                                    bool isSelf = currentUserId == u.UserId.ToString();

                                    <tr>
                                        <td class="text-center">@u.UserId</td>
                                    <td><strong>@u.FullName</strong></td>
                                    <td>@u.Email</td>
                                    <td>@u.Phone</td>
                                    <td class="text-center">
                                        <span class="badge @(u.Role == "Admin" ? "bg-danger" : "bg-info text-dark")">
                                            @u.Role
                                        </span>
                                    </td>
                                    <td class="text-center small">@u.CreatedAt?.ToShortDateString()</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-controller="Users" asp-action="Edit" asp-route-id="@u.UserId" class="btn btn-warning btn-sm">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                                @if (!isSelf)
                                                {
                                                    <button type="button" class="btn btn-danger btn-sm"
                                                            data-bs-toggle="modal" data-bs-target="#deleteUserModal"
                                                            data-user-id="@u.UserId" data-user-name="@u.FullName">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="text-center py-4">Список порожній</td></tr>
                        }
                    </tbody>
                </table>
                    @if (Model.TotalUsers > Model.PageSize)
                    {
                        int totalUserPages = (int)Math.Ceiling((double)Model.TotalUsers / Model.PageSize);
                        <nav aria-label="Page navigation" class="mt-3">
                            <ul class="pagination pagination-sm justify-content-center">
                                @for (int i = 1; i <= totalUserPages; i++)
                                {
                                    <li class="page-item @(Context.Request.Query["userPage"] == i.ToString() || (Context.Request.Query["userPage"].Count == 0 && i == 1) ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { userPage = i, userSearch = Model.UserSearch, activeTab = "tabUsers" })">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
            </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-shield-lock-fill text-danger" style="font-size: 4rem;"></i>
                    </div>
                    <h3 class="text-danger fw-bold">Доступ заборонено</h3>
                    <p class="text-muted lead">
                        Перегляд списку користувачів доступний лише адміністрації.
                    </p>
                </div>
            }
        </div>
        <!--ВІДГУКИ-->
        <div class="tab-pane fade" id="tabReviews" role="tabpanel" aria-labelledby="review-tab">
