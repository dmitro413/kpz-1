@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var activeTab = localStorage.getItem('activeTab');
            if (activeTab) {
                var tabTrigger = new bootstrap.Tab(document.querySelector(activeTab));
                tabTrigger.show();
            }

            var tabLinks = document.querySelectorAll('button[data-bs-toggle="tab"]');
            tabLinks.forEach(function (tabLink) {
                tabLink.addEventListener('shown.bs.tab', function (event) {
                    localStorage.setItem('activeTab', '#' + event.target.id);
                });
            });
        });

        const deleteBrandModal = document.getElementById('deleteBrandModal');
        if (deleteBrandModal) {
            deleteBrandModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const id = button.getAttribute('data-brand-id');
                const name = button.getAttribute('data-brand-name');
                document.getElementById('deleteBrandName').textContent = name;
                document.getElementById('deleteBrandForm').action = '/Brands/Delete/' + id;
            });
        }

                const deleteProductModal = document.getElementById('deleteProductModal');
        if (deleteProductModal) {
            deleteProductModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const id = button.getAttribute('data-product-id');
                const name = button.getAttribute('data-product-name');
                document.getElementById('deleteProductName').textContent = name;
                document.getElementById('deleteProductForm').action = '/Products/Delete/' + id;
            });
        }

        const deleteVariantModal = document.getElementById('deleteVariantModal');
        if (deleteVariantModal) {
            deleteVariantModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const id = button.getAttribute('data-variant-id');
                const info = button.getAttribute('data-variant-info');
                document.getElementById('deleteVariantInfo').textContent = info;
                document.getElementById('deleteVariantForm').action = '/Variants/Delete/' + id;
            });
        }

        const deleteTypeModal = document.getElementById('deleteTypeModal');
    if (deleteTypeModal) {
        deleteTypeModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;        
            const id = button.getAttribute('data-type-id');
            const name = button.getAttribute('data-type-name');
            document.getElementById('deleteTypeName').textContent = name;      
            document.getElementById('deleteTypeForm').action = '/Types/Delete/' + id;
        });
    }
    </script>
}