@model CourseWork.Models.Brand

@{
    bool isEdit = Model != null && Model.BrandId > 0;
    ViewBag.Title = isEdit ? "Редагування бренду" : "Додати новий бренд";

    string action = isEdit ? "Edit" : "Create";
    string btnText = isEdit ? "Зберегти зміни" : "Створити";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">@ViewBag.Title</h4>
                </div>
                <div class="card-body">
                    <form asp-controller="Brands" asp-action="@action" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        @if (isEdit)
                        {
                            <input type="hidden" asp-for="BrandId" />
                        }

                        <div class="mb-3">
                            <label asp-for="BrandName" class="form-label">Назва бренду</label>
                            <input asp-for="BrandName" class="form-control" placeholder="Введіть назву..." />
                            <span asp-validation-for="BrandName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Country" class="form-label">Країна</label>
                            <input asp-for="Country" class="form-control" placeholder="Введіть країну..." />
                            <span asp-validation-for="Country" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between pt-3">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Назад до списку
                            </a>

                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-lg"></i> @btnText
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}