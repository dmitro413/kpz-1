@model CourseWork.Core.Models.Product

@{
    bool isEdit = Model != null && Model.ProductId > 0;
    ViewData["Title"] = isEdit ? "Редагування товару" : "Додати новий товар";

    string actionName = isEdit ? "Edit" : "Create";
    string btnText = isEdit ? "Зберегти зміни" : "Створити товар";
    string currentImage = isEdit && !string.IsNullOrEmpty(Model.ImageUrl) ? Model.ImageUrl : "/images/no-image.png";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">@ViewData["Title"]</h4>
                </div>
                <div class="card-body">

                    <form asp-controller="Products" asp-action="@actionName" method="post" enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        @if (isEdit)
                        {
                            <input type="hidden" asp-for="ProductId" />
                            <input type="hidden" asp-for="CreatedAt" />
                            <input type="hidden" asp-for="ImageUrl" />
                        }

                        <div class="mb-4">
                            <label class="form-label">Зображення товару</label>

                            <div class="row">
                                <div class="col-md-4 text-center mb-3">
                                    <div class="border rounded p-2 bg-light">
                                        <img id="imagePreview"
                                             src="@currentImage"
                                             alt="Зображення товару"
                                             class="img-fluid rounded"
                                             style="max-height: 200px; object-fit: contain;" />
                                    </div>
                                    @if (isEdit)
                                    {
                                        <small class="text-muted d-block mt-2">Поточне зображення</small>
                                    }
                                </div>

                                <div class="col-md-8">
                                    <input type="file"
                                           name="imageFile"
                                           id="imageFile"
                                           class="form-control"
                                           accept="image/*"
                                           onchange="previewImage(event)" />
                                    <div class="form-text">
                                        <i class="bi bi-info-circle"></i>
                                        Формати: JPG, PNG, GIF, WEBP. Максимум 5 МБ.
                                        @if (isEdit)
                                        {
                                            <br />

                                            <strong>Якщо не оберете файл, поточне зображення залишиться.</strong>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">
                                <i class="bi bi-tag"></i> Назва товару
                            </label>
                            <input asp-for="Name" class="form-control" placeholder="Наприклад: Цукерки 'Ромашка'" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BrandId" class="form-label">
                                <i class="bi bi-award"></i> Бренд
                            </label>
                            <select asp-for="BrandId" class="form-select" asp-items="ViewBag.BrandId">
                                <option value="">-- Оберіть бренд --</option>
                            </select>
                            <span asp-validation-for="BrandId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TypeOfProductId" class="form-label">
                                <i class="bi bi-basket"></i> Тип продукту
                            </label>
                            <select asp-for="TypeOfProductId" class="form-select" asp-items="ViewBag.TypeOfProductId">
                                <option value="">-- Оберіть тип --</option>
                            </select>
                            <span asp-validation-for="TypeOfProductId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CaloriesPer100g" class="form-label">
                                <i class="bi bi-fire"></i> Калорійність (на 100г)
                            </label>
                            <div class="input-group">
                                <input asp-for="CaloriesPer100g" class="form-control" type="number" step="0.01" placeholder="350.5" />
                                <span class="input-group-text">ккал</span>
                            </div>
                            <span asp-validation-for="CaloriesPer100g" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">
                                <i class="bi bi-card-text"></i> Опис товару
                            </label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Короткий опис смаку та складу..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Назад до списку
                            </a>

                            <button type="submit" class="btn btn-success px-4">
                                <i class="bi bi-check-circle"></i> @btnText
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function previewImage(event) {
            const file = event.target.files[0];
            const preview = document.getElementById('imagePreview');

            if (file) {
                const maxSize = 5 * 1024 * 1024;
                if (file.size > maxSize) {
                    alert('Файл занадто великий! Максимальний розмір: 5 МБ');
                    event.target.value = '';
                    return;
                }

                const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
                if (!allowedTypes.includes(file.type)) {
                    alert('Недопустимий формат файлу! Використовуйте JPG, PNG, GIF або WEBP');
                    event.target.value = '';
                    return;
                }

                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                }
                reader.readAsDataURL(file);
            }
        }
    </script>
}