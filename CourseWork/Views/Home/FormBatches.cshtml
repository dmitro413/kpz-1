@model CourseWork.Core.Models.ProductBatch

@{
    bool isEdit = Model != null && Model.BatchId > 0;
    ViewData["Title"] = isEdit ? "Редагування партії" : "Прийом товару (Нова партія)";
    string actionName = isEdit ? "Edit" : "Create";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">@ViewData["Title"]</h4>
                </div>
                <div class="card-body">

                    <form asp-controller="Batches" asp-action="@actionName" method="post">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        @if (isEdit)
                        {
                            <input type="hidden" asp-for="BatchId" />
                        }


                        <div class="mb-3">
                            <label asp-for="VariantId" class="form-label fw-bold">Товар (Варіант)</label>
                            <select asp-for="VariantId" class="form-select select-search" asp-items="ViewBag.VariantId">
                                <option value="">-- Оберіть товар зі списку --</option>
                            </select>
                            <span asp-validation-for="VariantId" class="text-danger"></span>
                            <div class="form-text">Оберіть конкретну фасовку товару, яка надійшла на склад.</div>
                        </div>

                        <hr />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PurchasePrice" class="form-label">Ціна закупівлі (за 1 шт)</label>
                                <div class="input-group">
                                    <input asp-for="PurchasePrice" class="form-control" type="number" step="0.01" placeholder="0.00" />
                                    <span class="input-group-text">₴</span>
                                </div>
                                <span asp-validation-for="PurchasePrice" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="SupplierName" class="form-label">Постачальник</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-truck"></i></span>
                                    <input asp-for="SupplierName" class="form-control" placeholder="Назва фірми або ім'я..." />
                                </div>
                                <span asp-validation-for="SupplierName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Stock" class="form-label">Кількість</label>
                                <div class="input-group">
                                    <input asp-for="Stock" class="form-control" type="number" placeholder="0" />
                                    <span class="input-group-text">шт.</span>
                                </div>
                                <span asp-validation-for="Stock" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ManufactureDate" class="form-label">Дата поставки</label>
                                <input asp-for="ManufactureDate" class="form-control" type="date" />
                                <span asp-validation-for="ManufactureDate" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ExpiryDate" class="form-label">Термін придатності</label>
                                <input asp-for="ExpiryDate" class="form-control" type="date" />
                                <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Назад до списку
                            </a>
                            <button type="submit" class="btn btn-info text-white px-4">
                                <i class="bi bi-save"></i> Зберегти
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}