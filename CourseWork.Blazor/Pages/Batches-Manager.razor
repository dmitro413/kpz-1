@page "/batches-manager"
@using CourseWork.Core.Models
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.SignalR.Client
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject HubConnection HubConnection

<div class="container">
    <h3>Менеджер партій (Склад)</h3>

    @if (batches == null)
    {
        <p>...</p>
    }
    else
    {
        <table class="table table-hover mt-4">
            <thead>
                <tr>
                    <th>Товар (ID Варіанту)</th>
                    <th>Кількість</th>
                    <th>Придатний до</th>
                    <th>Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in batches)
                {
                    <tr>
                        <td>Партія #@b.BatchId (Варіант: @b.VariantId)</td>
                        <td>
                            <input type="number" class="form-control form-control-sm d-inline-block"
                                   style="width: 80px;"
                                   value="@b.Stock"
                                   @onchange="@(e => UpdateStock(b.BatchId, int.Parse(e.Value.ToString())))" />
                        </td>
                        <td>@b.ExpiryDate</td>
                        <td>
                            <button class="btn btn-danger btn-sm" @onclick="() => DeleteBatch(b.BatchId)">
                                <i class="bi bi-trash"></i> Видалити
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<ProductBatch>? batches;

    protected override async Task OnInitializedAsync()
    {
        await LoadBatches();
        if (HubConnection.State == HubConnectionState.Disconnected)
            await HubConnection.StartAsync();
    }

    async Task LoadBatches()
    {
        var token = await LocalStorage.GetItemAsync<string>("token");
        var request = new HttpRequestMessage(HttpMethod.Get, "api/batches");
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var response = await Http.SendAsync(request);
        if (response.IsSuccessStatusCode)
            batches = await response.Content.ReadFromJsonAsync<List<ProductBatch>>();
    }

    async Task UpdateStock(int batchId, int newStock)
    {
        var token = await LocalStorage.GetItemAsync<string>("token");
        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var response = await Http.PutAsJsonAsync($"api/batches/{batchId}/stock", newStock);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<StockUpdateResult>();

            await HubConnection.InvokeAsync("UpdateProductStock",
                result.ProductId, result.VariantId, result.TotalStock);

            await LoadBatches();
        }
    }

    async Task DeleteBatch(int id)
    {
        var token = await LocalStorage.GetItemAsync<string>("token");
        var request = new HttpRequestMessage(HttpMethod.Delete, $"api/batches/{id}");
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var response = await Http.SendAsync(request);
        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<StockUpdateResult>();

            await HubConnection.InvokeAsync("UpdateProductStock",
                result.ProductId, result.VariantId, result.TotalStock);

            await LoadBatches();
        }
    }

    public class StockUpdateResult
    {
        public int ProductId { get; set; }
        public int VariantId { get; set; }
        public int TotalStock { get; set; }
    }
}